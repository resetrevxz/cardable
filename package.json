{
  "name": "cardable",
  "productName": "Cardable",
  "version": "1.6.3",
  "description": "Cardable - GPU Card Collecting Game",
  "author": "Cardable Team",
  "main": "electron/main.js",
  "private": true,
  "scripts": {
    "postinstall": "install-electron",
    "dev": "electron . --dev",
    "electron:dev": "electron . --dev",
    "start": "electron .",
    "build": "electron-builder --config electron-builder.config.cjs --dir",
    "dist": "electron-builder --config electron-builder.config.cjs --publish never",
    "deliver:desktop": "node tools/deliver-desktop.cjs",
    "deliver:desktop:inspect": "node tools/deliver-desktop.cjs --inspect",
    "deliver:desktop:verify": "node tools/deliver-desktop.cjs --verify",
    "deliver:desktop:resume": "node tools/deliver-desktop.cjs --resume",
    "release:validate": "node tools/validate-release.cjs",
    "test:services": "node --test tests/electron-services.test.cjs",
    "test:desktop-optimization": "node tools/check-desktop-optimization.cjs",
    "profile:desktop": "node tools/profile-electron-graphics.cjs",
    "test": "node tools/verify-assets.cjs && npm run test:services && node tools/test-electron.cjs",
    "test:electron": "node tools/test-electron.cjs",
    "test:packaged": "node tools/test-electron.cjs --packaged",
    "test:regression": "node tools/test-electron-regression.cjs",
    "test:nsis-update": "node tools/test-nsis-update.cjs",
    "test:cinematics": "node tools/test-electron-cinematics.cjs",
    "test:package": "node tools/verify-package.cjs",
    "generate-icons": "node tools/generate-icons.cjs",
    "site:build": "node tools/build-site.cjs",
    "check:data": "node scripts/check-data.js",
    "release:github": "node tools/release-github.cjs",
    "test:mini": "node tools/test-mini-mode.cjs",
    "test:merged-collections": "node tools/check-merged-collections.cjs",
    "test:market": "node --test tests/market-core.test.cjs tests/market-sim.test.cjs tests/market-sim-provider.test.cjs tests/market-sales.test.cjs",
    "check:market": "node tools/check-market-browser.cjs",
    "check:market-sim": "node tools/check-market-sim-browser.cjs",
    "check:market-economy": "node tools/check-market-economy-browser.cjs",
    "check:market-online": "node tools/check-market-online-browser.cjs",
    "test:cloudflare": "node --test cloudflare/test/api.test.mjs cloudflare/test/analytics.test.mjs cloudflare/test/social.test.mjs cloudflare/test/economy.test.mjs cloudflare/test/trading.test.mjs cloudflare/test/races.test.mjs",
    "check:market-trading": "node tools/check-market-trading-browser.cjs",
    "check:market-analytics": "node tools/check-market-analytics-browser.cjs",
    "economy:global": "node tools/global-economy-experiment.cjs",
    "cloudflare:check": "node cloudflare/scripts/deploy.cjs --check",
    "economy:experiment": "node tools/economy-experiment.cjs",
    "sim:experiment": "node tools/sim-experiment.cjs"
  },
  "dependencies": {
    "discord-rpc": "^4.0.1",
    "electron-updater": "^6.8.9"
  },
  "devDependencies": {
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "playwright": "1.63.0"
  },
  "build": {
    "appId": "com.cardable.game",
    "productName": "Cardable",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "index.html",
      "package.json",
      "src/**/*",
      "assets/**/*",
      "electron/**/*",
      "vendor/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "dir",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icons/icon.ico",
      "artifactName": "Cardable-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "allowElevation": false,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "include": "tools/nsis-installer.nsh",
      "shortcutName": "Cardable",
      "uninstallDisplayName": "Cardable"
    }
  }
}
