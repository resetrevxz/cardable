# Archive originals retain captured bytes, line endings and historical spacing.
# Their recorded SHA-256 is checked instead of rewriting whitespace as new source.
archive/4.2.0-cleanup/** -text -whitespace
archive/workspace-organization/** -text -whitespace
archive/update-history/** -text -whitespace
*.webp binary
*.png binary
*.ico binary
*.woff2 binary
*.ttf binary
site/*.js text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
# Keep upstream license texts byte-for-byte, including their original spacing.
assets/fonts/*-OFL.txt -text -whitespace
